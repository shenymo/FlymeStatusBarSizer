<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <queries>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND_MULTIPLE" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.android.systemui" />
        <package android:name="com.android.intentresolver" />
        <package android:name="com.meizu.media.gallery" />
        <package android:name="com.meizu.pps" />
        <package android:name="com.meizu.safe" />
        <package android:name="com.meizu.flyme.launcher" />
        <package android:name="com.meizu.assistant" />
        <package android:name="com.flyme.systemuitools" />
        <package android:name="com.upuphone.carlink" />
        <package android:name="com.android.inputmethod.latin" />
        <package android:name="com.google.android.inputmethod.latin" />
        <package android:name="com.tencent.wetype" />
        <package android:name="flyme.inputmethod" />
    </queries>

    <application
        android:allowBackup="false"
        android:description="@string/module_description"
        android:directBootAware="true"
        android:extractNativeLibs="false"
        android:hasCode="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:enableOnBackInvokedCallback="true"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.INFO" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <activity
            android:name=".feature.onehanded.OneStepActivity"
            android:theme="@style/OneStepTheme"
            android:label="应用工作台"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density|fontScale|locale|layoutDirection|colorMode"
            android:exported="true"
            android:permission="android.permission.STATUS_BAR_SERVICE"
            android:taskAffinity="${applicationId}.workspace"
            android:excludeFromRecents="true"
            android:autoRemoveFromRecents="true"
            android:resizeableActivity="false"
            android:enableOnBackInvokedCallback="true"
            android:windowSoftInputMode="adjustNothing" />

        <activity-alias
            android:name=".MainActivityAlias"
            android:enabled="true"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name=".feature.assistant.AssistantBackgroundProvider"
            android:authorities="${applicationId}.assistant.background"
            android:directBootAware="false"
            android:exported="true" />

        <provider
            android:name=".feature.launcher.organizer.LauncherOrganizerProvider"
            android:authorities="${applicationId}.organizer"
            android:exported="true" />
    </application>
</manifest>
